{
  "name": "@ragabor/pensieve",
  "version": "0.1.0",
  "description": "A process-memory prompt stack for Pi",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/ragabor/pensieve#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ragabor/pensieve.git"
  },
  "files": [
    "index.ts",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.0",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1"
  }
}
