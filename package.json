{
  "name": "@ragabor/pensieve",
  "version": "0.1.0",
  "description": "A process-memory prompt stack for Pi",
  "private": true,
  "type": "module",
  "license": "WTFPL",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/ragabor/pensieve#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ragabor/pensieve.git"
  },
  "files": [
    "index.ts",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.0",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.0",
    "@types/node": "26.3.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
